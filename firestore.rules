rules_version = '2';
// Tennoform security rules. Everything not explicitly allowed here is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function data() { return request.resource.data; }
    function isFriendOf(owner, other) {
      return exists(/databases/$(database)/documents/users/$(owner)/friends/$(other));
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function shortStr(v, n) { return v is string && v.size() <= n; }
    function okTask(t) {
      return t is map && t.keys().hasOnly(['id', 'k', 'r', 't'])
        && (!('id' in t) || shortStr(t.id, 40)) && (!('k' in t) || shortStr(t.k, 12))
        && (!('r' in t) || shortStr(t.r, 200)) && (!('t' in t) || shortStr(t.t, 200));
    }

    // Your own saved progress and profile. Nobody else can read or write them.
    match /users/{uid}/data/{doc} {
      allow read, write: if signedIn() && me() == uid && doc in ['progress', 'profile'];
    }

    // Your friends list. Only you can see or change it.
    match /users/{uid}/friends/{fid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid && fid != uid
        && data().keys().hasOnly(['name', 'code', 'pending', 'at'])
        && shortStr(data().name, 40);
    }

    // Public card friends see. Readable one at a time (no listing everyone).
    match /public/{uid} {
      allow get: if signedIn();
      allow delete: if signedIn() && me() == uid;
      allow write: if signedIn() && me() == uid
        && data().keys().hasOnly(['name', 'code', 'mr', 'xp', 'nodes', 'sp', 'maxed', 'cats', 'at'])
        && shortStr(data().name, 40) && shortStr(data().code, 6)
        && data().mr is number && data().xp is number && data().nodes is number
        && data().sp is number && data().maxed is number && data().at is number
        && data().cats is map && data().cats.size() <= 20;
    }

    // Friend codes: claimed once, never changed, looked up one at a time.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.size() == 6
        && data().keys().hasOnly(['uid']) && data().uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Inbox: friend requests, messages and task invites.
    match /inbox/{uid}/msgs/{id} {
      allow read, delete: if signedIn() && me() == uid;
      allow update: if signedIn() && me() == uid
        && data().diff(resource.data).affectedKeys().hasOnly(['ans'])
        && shortStr(data().ans, 8);
      allow create: if signedIn()
        && data().from == me()
        && data().keys().hasOnly(['from', 'fromName', 'code', 'to', 'type', 'text', 'task', 'at'])
        && data().at is number
        && (!('text' in data()) || shortStr(data().text, 1000))
        && (!('fromName' in data()) || shortStr(data().fromName, 40))
        && (!('code' in data()) || shortStr(data().code, 6))
        && (!('to' in data()) || shortStr(data().to, 128))
        && (!('task' in data()) || okTask(data().task))
        && (
          // a copy of something you sent, in your own inbox
          (me() == uid && data().type == 'sent')
          // a friend request to someone else
          || (me() != uid && data().type == 'friend')
          // accepting: only possible if they asked you first (they list you as pending)
          || (me() != uid && data().type == 'accept' && isFriendOf(me(), uid) && isFriendOf(uid, me()))
          // messages and task updates: only to people who have you as a friend
          || (me() != uid && data().type in ['msg', 'task', 'taskok', 'taskno', 'taskdone'] && isFriendOf(uid, me()))
        );
    }

    // Group chats: only members can read, post or change the group.
    match /groups/{gid} {
      function okGroup() {
        return data().keys().hasOnly(['name', 'owner', 'members', 'names', 'at'])
          && shortStr(data().name, 40)
          && data().members is list && data().members.size() <= 25
          && data().names is map && data().names.size() <= 25;
      }
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && okGroup() && data().owner == me() && me() in data().members;
      allow update: if signedIn() && okGroup() && me() in resource.data.members
        && data().owner == resource.data.owner
        && data().diff(resource.data).affectedKeys().hasOnly(['name', 'members', 'names', 'at'])
        // only the owner can remove other people; anyone can leave or add
        && (me() == resource.data.owner || data().members.hasAll(resource.data.members.removeAll([me()])));
      allow delete: if signedIn() && resource.data.owner == me();

      match /msgs/{id} {
        function isMember() {
          return me() in get(/databases/$(database)/documents/groups/$(gid)).data.members;
        }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember()
          && data().from == me()
          && data().keys().hasOnly(['from', 'fromName', 'type', 'text', 'task', 'at'])
          && data().at is number
          && data().type in ['msg', 'task', 'taskok', 'taskdone', 'sys']
          && (!('text' in data()) || shortStr(data().text, 1000))
          && (!('fromName' in data()) || shortStr(data().fromName, 40))
          && (!('task' in data()) || okTask(data().task));
      }
    }

    // Feedback: signed-in users can send; only admins can read.
    match /feedback/{id} {
      allow create: if signedIn() && data().uid == me()
        && data().keys().hasOnly(['text', 'kind', 'page', 'contact', 'uid', 'name', 'at'])
        && data().text is string && data().text.size() > 0 && data().text.size() <= 2000
        && data().kind in ['bug', 'idea', 'other']
        && data().at is number
        && (!('page' in data()) || shortStr(data().page, 40))
        && (!('contact' in data()) || shortStr(data().contact, 120))
        && (!('name' in data()) || shortStr(data().name, 40));
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && data().diff(resource.data).affectedKeys().hasOnly(['done']);
    }
  }
}
