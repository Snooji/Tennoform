rules_version = '2';
// Tennoform security rules. Everything not explicitly allowed here is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function data() { return request.resource.data; }
    function isFriendOf(owner, other) {
      return exists(/databases/$(database)/documents/users/$(owner)/friends/$(other));
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function shortStr(v, n) { return v is string && v.size() <= n; }
    function okTask(t) {
      return t is map && t.keys().hasOnly(['id', 'k', 'r', 't'])
        && (!('id' in t) || shortStr(t.id, 40)) && (!('k' in t) || shortStr(t.k, 12))
        && (!('r' in t) || shortStr(t.r, 200)) && (!('t' in t) || shortStr(t.t, 200));
    }

    // Your own saved progress and profile. Nobody else can read or write them.
    match /users/{uid}/data/{doc} {
      allow read, write: if signedIn() && me() == uid && doc in ['progress', 'profile'];
    }

    // Your friends list. Only you can see or change it.
    match /users/{uid}/friends/{fid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid && fid != uid
        && data().keys().hasOnly(['name', 'code', 'pending', 'at'])
        && shortStr(data().name, 40);
    }

    // Public card friends see. Readable one at a time; only admins can list them (to count players).
    match /public/{uid} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow delete: if signedIn() && me() == uid;
      allow write: if signedIn() && me() == uid
        && data().keys().hasOnly(['name', 'code', 'mr', 'xp', 'nodes', 'sp', 'maxed', 'cats', 'at'])
        && shortStr(data().name, 40) && shortStr(data().code, 6)
        && data().mr is number && data().xp is number && data().nodes is number
        && data().sp is number && data().maxed is number && data().at is number
        && data().cats is map && data().cats.size() <= 20;
    }

    // Friend codes: claimed once, never changed, looked up one at a time.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.size() == 6
        && data().keys().hasOnly(['uid']) && data().uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Inbox: friend requests, messages and task invites.
    match /inbox/{uid}/msgs/{id} {
      allow read, delete: if signedIn() && me() == uid;
      allow update: if signedIn() && me() == uid
        && data().diff(resource.data).affectedKeys().hasOnly(['ans'])
        && shortStr(data().ans, 8);
      allow create: if signedIn()
        && data().from == me()
        && data().keys().hasOnly(['from', 'fromName', 'code', 'to', 'type', 'text', 'task', 'at'])
        && data().at is number
        && (!('text' in data()) || shortStr(data().text, 1000))
        && (!('fromName' in data()) || shortStr(data().fromName, 40))
        && (!('code' in data()) || shortStr(data().code, 6))
        && (!('to' in data()) || shortStr(data().to, 128))
        && (!('task' in data()) || okTask(data().task))
        && (
          // a copy of something you sent, in your own inbox
          (me() == uid && data().type == 'sent')
          // a friend request to someone else
          || (me() != uid && data().type == 'friend')
          // accepting: only possible if they asked you first (they list you as pending)
          || (me() != uid && data().type == 'accept' && isFriendOf(me(), uid) && isFriendOf(uid, me()))
          // messages and task updates: only to people who have you as a friend
          || (me() != uid && data().type in ['msg', 'task', 'taskok', 'taskno', 'taskdone'] && isFriendOf(uid, me()))
        );
    }

    // Group chats: only members can read, post or change the group.
    match /groups/{gid} {
      function okGroup() {
        return data().keys().hasOnly(['name', 'owner', 'members', 'names', 'at'])
          && shortStr(data().name, 40)
          && data().members is list && data().members.size() <= 25
          && data().names is map && data().names.size() <= 25;
      }
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && okGroup() && data().owner == me() && me() in data().members;
      allow update: if signedIn() && okGroup() && me() in resource.data.members
        && data().owner == resource.data.owner
        && data().diff(resource.data).affectedKeys().hasOnly(['name', 'members', 'names', 'at'])
        // only the owner can remove other people; anyone can leave or add
        && (me() == resource.data.owner || data().members.hasAll(resource.data.members.removeAll([me()])));
      allow delete: if signedIn() && resource.data.owner == me();

      match /msgs/{id} {
        function isMember() {
          return me() in get(/databases/$(database)/documents/groups/$(gid)).data.members;
        }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember()
          && data().from == me()
          && data().keys().hasOnly(['from', 'fromName', 'type', 'text', 'task', 'at'])
          && data().at is number
          && data().type in ['msg', 'task', 'taskok', 'taskdone', 'sys']
          && (!('text' in data()) || shortStr(data().text, 1000))
          && (!('fromName' in data()) || shortStr(data().fromName, 40))
          && (!('task' in data()) || okTask(data().task));
      }
    }

    // Donation log: only admins can read or write it.
    match /donations/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && data().keys().hasOnly(['at', 'kind', 'amount', 'who', 'note', 'by'])
        && data().kind in ['plat', 'paypal', 'other']
        && data().amount is number && data().amount >= 0 && data().amount <= 1000000
        && data().at is number && data().by == me()
        && (!('who' in data()) || shortStr(data().who, 60))
        && (!('note' in data()) || shortStr(data().note, 200));
    }

    // Shared builds: anyone can browse; you publish, edit and delete your own.
    // Votes live in builds/{id}/votes/{uid}; the up/down counts must move by exactly your vote, in the same write.
    match /builds/{bid} {
      function strList(l, n, m) {
        return l is list && l.size() <= n
          && (l.size() < 1 || shortStr(l[0], m)) && (l.size() < 2 || shortStr(l[1], m))
          && (l.size() < 3 || shortStr(l[2], m)) && (l.size() < 4 || shortStr(l[3], m))
          && (l.size() < 5 || shortStr(l[4], m)) && (l.size() < 6 || shortStr(l[5], m))
          && (l.size() < 7 || shortStr(l[6], m)) && (l.size() < 8 || shortStr(l[7], m))
          && (l.size() < 9 || shortStr(l[8], m)) && (l.size() < 10 || shortStr(l[9], m));
      }
      function okBuild() {
        return data().keys().hasOnly(['uid', 'author', 'item', 'name', 'role', 'aura', 'exilus', 'mods', 'arcanes', 'helminth', 'notes', 'at', 'up', 'down', 'score'])
          && data().keys().hasAll(['uid', 'item', 'name', 'mods', 'at', 'up', 'down', 'score'])
          && shortStr(data().item, 60) && data().item.size() > 0 && shortStr(data().name, 60)
          && shortStr(data().get('author', ''), 40) && shortStr(data().get('role', ''), 60)
          && shortStr(data().get('aura', ''), 60) && shortStr(data().get('exilus', ''), 60)
          && shortStr(data().get('helminth', ''), 60) && shortStr(data().get('notes', ''), 600)
          && strList(data().mods, 10, 60) && strList(data().get('arcanes', []), 2, 60)
          && data().at is number && data().up is int && data().down is int && data().score is int;
      }
      function vote(path) { return exists(path) ? get(path).data.v : 0; }
      function voteAfter(path) { return existsAfter(path) ? getAfter(path).data.v : 0; }
      function countsMatchVote() {
        let path = /databases/$(database)/documents/builds/$(bid)/votes/$(me());
        let before = vote(path);
        let after = voteAfter(path);
        return before != after
          && data().up == resource.data.up + (after == 1 ? 1 : 0) - (before == 1 ? 1 : 0)
          && data().down == resource.data.down + (after == -1 ? 1 : 0) - (before == -1 ? 1 : 0)
          && data().score == data().up - data().down;
      }
      allow read: if true;
      allow create: if signedIn() && okBuild() && data().uid == me()
        && data().up == 0 && data().down == 0 && data().score == 0;
      // the author edits the build itself, never the counts
      allow update: if signedIn() && okBuild() && resource.data.uid == me()
        && data().diff(resource.data).affectedKeys().hasOnly(['author', 'name', 'role', 'aura', 'exilus', 'mods', 'arcanes', 'helminth', 'notes', 'item']);
      // anyone signed in votes: only the counts change, and they match the vote they're writing
      allow update: if signedIn()
        && data().diff(resource.data).affectedKeys().hasOnly(['up', 'down', 'score'])
        && countsMatchVote();
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());

      match /votes/{uid} {
        function countsMoved() {
          let b = /databases/$(database)/documents/builds/$(bid);
          return getAfter(b).data.score != get(b).data.score;
        }
        allow read: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid
          && data().keys().hasOnly(['v']) && data().v in [1, -1] && countsMoved();
        allow delete: if signedIn() && me() == uid && countsMoved();
      }
    }

    // Presence: when a signed-in player was last active and which days they visited (UTC dates).
    // Only admins can read it, to count live and daily players. Nothing else is stored.
    match /presence/{uid} {
      allow read: if isAdmin();
      allow delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && data().keys().hasOnly(['at', 'day', 'days'])
        && data().at is number && data().day is string && data().day.size() == 10
        && data().days is list && data().days.size() <= 400;
    }

    // Community chat. Public rooms (general, trade, lfg) can be read by anyone; clan and alliance rooms
    // (c_<clan id>, a_<alliance id>) by players whose synced profile says they belong. Posting needs an
    // account and no ban. Messages that match the filter can't be posted; the app sends them to the
    // review queue instead, which only admins can read.
    function chatFlag(t) {
      return t.lower().matches("[\\s\\S]*((child|kid|kids|minor|minors|underage|preteen|toddler|loli|shota)[^a-z]{0,3}(porn|nude|nudes|sex|xxx|naked)|(porn|nude|nudes|sex|xxx|naked)[^a-z]{0,3}(child|kid|kids|minor|minors|underage|preteen|toddler)|(selling|sell|buy|vendor|plug)[^a-z]+([a-z]+[^a-z]+){0,3}(cocaine|heroin|fentanyl|meth|mdma|ketamine|xanax|oxy|oxys|lsd)([^a-z]|$)|ghost gun|untraceable gun|glock switch|auto sear|(stolen|hacked)[^a-z]+(credit cards?|cards|cc|paypal accounts?|bank accounts?)|fullz|carding|cvv dumps?|kill (your ?self|urself)|(^|[^a-z])kys([^a-z]|$)|(send|selling|sell)[^a-z]+nudes|(onlyfans|porn)[^a-z]*(leaks?|links?))[\\s\\S]*");
    }
    function chatMe() { return get(/databases/$(database)/documents/chatme/$(request.auth.uid)).data; }
    function inRoom(room) {
      return room in ['general', 'trade', 'lfg']
        || (signedIn() && exists(/databases/$(database)/documents/chatme/$(request.auth.uid))
            && ((chatMe().g != '' && room == 'c_' + chatMe().g) || (chatMe().a != '' && room == 'a_' + chatMe().a)));
    }
    function notBanned() { return !exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }
    match /rooms/{room}/msgs/{id} {
      allow read: if inRoom(room) || isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == me());
      allow create: if isAdmin() || (signedIn() && notBanned() && inRoom(room)
        && data().keys().hasOnly(['uid', 'name', 'text', 'at'])
        && data().uid == me() && shortStr(data().name, 40)
        && data().text is string && data().text.size() > 0 && data().text.size() <= 500
        && data().at is number && data().at > request.time.toMillis() - 120000 && data().at < request.time.toMillis() + 120000
        && !chatFlag(data().text));
    }
    // Which clan and alliance rooms you're in, from your synced profile.
    match /chatme/{uid} {
      allow read: if (signedIn() && me() == uid) || isAdmin();
      allow delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && data().keys().hasOnly(['g', 'a', 'gn', 'name', 'at'])
        && data().g is string && (data().g == '' || data().g.matches('[0-9a-f]{24}'))
        && data().a is string && (data().a == '' || data().a.matches('[0-9a-f]{24}'))
        && shortStr(data().gn, 60) && shortStr(data().name, 40) && data().at is number;
    }
    // Flagged messages wait here for an admin: publish, remove, or remove and ban.
    match /review/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn() && notBanned()
        && data().keys().hasOnly(['room', 'uid', 'name', 'text', 'flag', 'at'])
        && data().uid == me() && shortStr(data().room, 40) && shortStr(data().name, 40) && shortStr(data().flag, 40)
        && data().text is string && data().text.size() > 0 && data().text.size() <= 500 && data().at is number;
    }
    // Banned players can't post or send to review. Only admins manage bans; you can see if you're banned.
    match /bans/{uid} {
      allow read: if isAdmin() || (signedIn() && me() == uid);
      allow write: if isAdmin();
    }

    // Feedback: signed-in users can send; only admins can read.
    match /feedback/{id} {
      allow create: if signedIn() && data().uid == me()
        && data().keys().hasOnly(['text', 'kind', 'page', 'contact', 'uid', 'name', 'at'])
        && data().text is string && data().text.size() > 0 && data().text.size() <= 2000
        && data().kind in ['bug', 'idea', 'other']
        && data().at is number
        && (!('page' in data()) || shortStr(data().page, 40))
        && (!('contact' in data()) || shortStr(data().contact, 120))
        && (!('name' in data()) || shortStr(data().name, 40));
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && data().diff(resource.data).affectedKeys().hasOnly(['done']);
    }
  }
}
