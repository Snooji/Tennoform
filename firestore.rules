rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isFriendOf(owner, other) {
      return exists(/databases/$(database)/documents/users/$(owner)/friends/$(other));
    }

    // Your own saved progress.
    match /users/{uid}/data/{doc} {
      allow read, write: if signedIn() && me() == uid && doc in ['progress', 'profile'];
    }

    // Your friends list. Only you can see or change it.
    match /users/{uid}/friends/{fid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Public card (name, friend code, MR) that friends see.
    match /public/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'code', 'mr', 'xp', 'nodes', 'sp', 'maxed', 'cats', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
    }

    // Friend codes: claimed once, never changed.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && code.size() == 6
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == me();
    }

    // Inbox: friend requests, messages and shared-task invites.
    match /inbox/{uid}/msgs/{id} {
      allow read, delete: if signedIn() && me() == uid;
      allow update: if signedIn() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ans']);
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'code', 'to', 'type', 'text', 'task', 'at'])
        && request.resource.data.at is number
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 1000))
        && (!('fromName' in request.resource.data) || (request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40))
        && (
          (me() == uid && request.resource.data.type == 'sent')
          || (me() != uid && request.resource.data.type == 'friend')
          || (me() != uid && request.resource.data.type == 'accept' && isFriendOf(me(), uid))
          || (me() != uid && request.resource.data.type in ['msg', 'task', 'taskok', 'taskno', 'taskdone'] && isFriendOf(uid, me()))
        );
    }
  
    // Group chats: only members can read, post or change the group.
    match /groups/{gid} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && request.resource.data.owner == me()
        && me() in request.resource.data.members
        && request.resource.data.members is list && request.resource.data.members.size() <= 25
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'names', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'members', 'names', 'at'])
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.members is list && request.resource.data.members.size() <= 25
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow delete: if signedIn() && resource.data.owner == me();

      match /msgs/{id} {
        function isMember() {
          return me() in get(/databases/$(database)/documents/groups/$(gid)).data.members;
        }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember()
          && request.resource.data.from == me()
          && request.resource.data.keys().hasOnly(['from', 'fromName', 'type', 'text', 'task', 'at'])
          && request.resource.data.at is number
          && request.resource.data.type in ['msg', 'task', 'taskok', 'taskdone', 'sys']
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 1000))
          && (!('fromName' in request.resource.data) || (request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40));
      }
    }

    // Feedback: anyone can send; only admins (listed in the admins collection) can read.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text', 'kind', 'page', 'contact', 'uid', 'name', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.kind in ['bug', 'idea', 'other']
        && request.resource.data.at is number
        && (!('page' in request.resource.data) || (request.resource.data.page is string && request.resource.data.page.size() <= 40))
        && (!('contact' in request.resource.data) || (request.resource.data.contact is string && request.resource.data.contact.size() <= 120))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 40))
        && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == me()));
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done']);
    }
  }
}
